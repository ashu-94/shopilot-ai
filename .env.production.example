# Generate unique URL-safe secrets, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# Copy to .env.production, which is gitignored. Do not commit real credentials.
PUBLIC_HOST=shop.example.com
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GRAFANA_PASSWORD=
LLM_PROVIDER=deterministic
SPECIALIST_MODELS_ENABLED=false
# To enable bounded model-driven specialists, set provider/key/models and true above.
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_ADVANCED_MODEL=
