{"uid":"shopilot","title":"ShopPilot — Commerce & Agent Operations","schemaVersion":39,"version":1,"refresh":"10s","time":{"from":"now-1h","to":"now"},"panels":[{"id":1,"title":"HTTP requests / second","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(rate(shopilot_http_requests_total[5m])) by (status)","legendFormat":"{{status}}"}]},{"id":2,"title":"MCP latency p95","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(shopilot_mcp_duration_seconds_bucket[5m])) by (le,tool))","legendFormat":"{{tool}}"}]},{"id":3,"title":"Cache hit ratio","type":"stat","gridPos":{"x":0,"y":8,"w":6,"h":5},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(rate(shopilot_cache_total{outcome=\"hit\"}[5m])) / sum(rate(shopilot_cache_total{outcome=~\"hit|miss\"}[5m]))"}]},{"id":4,"title":"Workflow duration p95","type":"timeseries","gridPos":{"x":6,"y":8,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(shopilot_workflow_duration_seconds_bucket[5m])) by (le,kind))","legendFormat":"{{kind}}"}]},{"id":5,"title":"Event processing","type":"timeseries","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(rate(shopilot_events_total[5m])) by (outcome)","legendFormat":"{{outcome}}"}]},{"id":6,"title":"Database duration p95","type":"timeseries","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(shopilot_database_duration_seconds_bucket[5m])) by (le))"}]}]}
