APP_ENV=development
DATABASE_URL=sqlite:///./data/shopilot.db
CHECKPOINT_URL=./data/checkpoints.db
# Generate a unique secret before exposing the app. The default is local-demo only.
JWT_SECRET=local-demo-only-change-this-32-character-secret
DEMO_PASSWORD=ShopPilot-demo-2026!
SEED_DEMO=true
REDIS_URL=
QDRANT_URL=
KAFKA_BOOTSTRAP_SERVERS=
MCP_TRANSPORT=inprocess
MCP_HOST=mcp
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_FAST_MODEL=gpt-4.1-mini
LLM_ADVANCED_MODEL=gpt-4.1
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopilot-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
APPROVAL_THRESHOLD=100000
REFUND_APPROVAL_THRESHOLD=10000
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=shopilot-documents
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
